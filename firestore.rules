rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['theme', 'credentialIds'])
        && (!('theme' in request.resource.data) || request.resource.data.theme in ['light', 'dark'])
        && (!('credentialIds' in request.resource.data)
          || (request.resource.data.credentialIds is list && request.resource.data.credentialIds.size() <= 20));
      match /transactions/{transactionId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasAll(['desc', 'amount', 'type', 'category', 'date'])
          && request.resource.data.keys().hasOnly(['desc', 'amount', 'type', 'category', 'date'])
          && request.resource.data.desc is string && request.resource.data.desc.size() > 0
          && request.resource.data.desc.size() <= 1000
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.category is string && request.resource.data.category.size() <= 100
          && request.resource.data.date is string && request.resource.data.date.size() <= 40;
      }
    }
  }
}
